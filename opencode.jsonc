{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
          "setCacheKey": true
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek Pro"
        }
      }
    }
  },
  "mcp": {
  },
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "default_agent": "brainstorm"
}

